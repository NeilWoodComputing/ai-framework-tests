# UI.NextJs.Framework editor settings (pre-handoff-checks T-GATE-002; plan D5, D7).
# The pre-handoff gate eol check (ai-code-framework/scripts/pre-handoff-checks.mjs) enforces line endings,
# final newline and no BOM; keep .gitattributes in step with this file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,mdc}]
trim_trailing_whitespace = false

[*.{ps1,psm1,psd1,cmd,bat}]
end_of_line = crlf
