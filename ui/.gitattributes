# UI.NextJs.Framework line endings (pre-handoff-checks T-GATE-002; plan D5, D7). Matches .editorconfig.
# Inert until this folder is a git repository (it is not one today; no git init without Neil).
* text=auto eol=lf

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.mdc text eol=lf
*.feature text eol=lf
*.yml text eol=lf
